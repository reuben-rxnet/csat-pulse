# ---------- App ----------
PORT=3100
# The address end users open from the survey email (must be reachable from their PCs / phones)
PUBLIC_BASE_URL=https://csat.yourdomain.example
DATABASE_URL=postgres://csat:change-me@localhost:5433/csat
DATABASE_SSL=false

# ---------- HDA (HelpDesk Advanced) REST API ----------
# Base URL is everything before /Authentication/... in the Postman collection ({{BaseUrl}})
# HDA QA (same as HDAConnect): https://helpdeskquality.luxottica.com/HDAPortal   Local mock: http://localhost:4010/api
HDA_BASE_URL=http://localhost:4010/api
# apikey  -> POST /Authentication/Token  ApiKey + TokenMode=apikey + Username
# trusted -> POST /Authentication/Token  ApiKey + TokenMode=trusted + TrustedUsername/TrustedPassword + Username
# login   -> POST /Authentication/LoginEx JSON {username, password}  (what HDAConnect uses; mock password: mock-password)
HDA_AUTH_MODE=apikey
HDA_API_KEY=mock-api-key
HDA_USERNAME=csat.api
HDA_PASSWORD=
HDA_TRUSTED_USERNAME=
HDA_TRUSTED_PASSWORD=
HDA_SOURCE_APPLICATION=CSAT-Pulse
HDA_MAPPING_FILE=config/hda-mapping.json

# ---------- Scheduler ----------
SCHEDULER_ENABLED=true
POLL_INTERVAL_MINUTES=5
GROUP_SYNC_INTERVAL_HOURS=24
# On the very first run, only tickets closed in this many hours are considered (avoids emailing old tickets)
INITIAL_LOOKBACK_HOURS=24

# ---------- Email ----------
# graph = Microsoft Graph sendMail (recommended) | smtp = SMTP relay | file = write emails to ./outbox (testing)
MAIL_TRANSPORT=file
MAIL_FROM=it-feedback@yourdomain.example
MAIL_FROM_NAME=EssilorLuxottica IT
MAIL_REPLY_TO=
# Pilot / dry-run: send every email to this address instead of the real requester
MAIL_TEST_RECIPIENT=

# PDF reports (Admin → Reports). Reports are sent straight to the addresses an admin types (MAIL_TEST_RECIPIENT does not apply),
# so only these domains are accepted (comma-separated; subdomains included; empty = any address).
REPORT_RECIPIENT_DOMAINS=essilor*,luxottica*,nikonlenswear.com
REPORT_MAX_RECIPIENTS=50

# Contact named on the Help page and the public "About this survey" page
SUPPORT_NAME=
SUPPORT_EMAIL=
# Who gets low-score alerts when an owner group has no lead email set
ALERT_FALLBACK_EMAIL=

# Graph (Entra ID app registration with application permission Mail.Send, ideally limited to the sender
# mailbox with an Exchange application access policy)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_UPN=it-feedback@yourdomain.example

# SMTP relay
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Outlook Actionable Messages (answer inside Outlook). Needs a provider registered at
# https://outlook.office.com/connectors/oam/publish and works with MAIL_TRANSPORT=graph or smtp via Exchange Online.
MAIL_ACTIONABLE=false
ACTIONABLE_ORIGINATOR_ID=

# ---------- Admin access ----------
# basic    = username/password prompt (pilot)
# oidc     = company single sign-on (Microsoft Entra ID or another OpenID Connect provider), handled by CSAT Pulse
# easyauth = Azure App Service Authentication with Entra ID in front of the app
# ADMIN_EMAILS = global admins (comma-separated). With oidc, people with the app role OIDC_ADMIN_ROLE are global admins too.
# Everyone else who signs in becomes a team admin for the owner groups they are assigned to in HDA.
ADMIN_AUTH_MODE=basic
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAILS=

# ---------- Company sign-in (ADMIN_AUTH_MODE=oidc) ----------
# From the IAM team's app registration. Entra ID issuer: https://login.microsoftonline.com/<tenant-id>/v2.0
# Redirect URI to register: PUBLIC_BASE_URL + OIDC_REDIRECT_PATH (e.g. http://localhost:3100/auth/callback for testing).
# Try it first without IAM: npm run mock:oidc, then OIDC_ISSUER=http://localhost:4020, OIDC_CLIENT_ID=csat-pulse, OIDC_CLIENT_SECRET=mock-secret
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_PATH=/auth/callback
OIDC_SCOPES=openid profile email
OIDC_ADMIN_ROLE=CSAT.GlobalAdmin
# Random text of 32+ characters that signs the sign-in cookie; keep it secret (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
SESSION_HOURS=8

# ---------- Branding ----------
BRAND_COMPANY=EssilorLuxottica
BRAND_UNIT=IT
BRAND_PRODUCT=CSAT Pulse
# Public HTTPS URL of the official logo (white version works best on the navy header)
BRAND_LOGO_URL=

# Stakeholder surveys (Admin → Stakeholder surveys): invitations only go to these company domains.
# "*" is a wildcard for the company part and subdomains count: "essilor*" covers essilor.co.th, essilorusa.com, cn.essilor.com …
FORM_RECIPIENT_DOMAINS=essilor*,luxottica*,nikonlenswear.com
